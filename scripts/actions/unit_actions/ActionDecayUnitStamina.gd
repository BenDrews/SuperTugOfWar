## Units on the battlefield lose stamina. Units that reach 0 stamina are discarded, which also
## sends their card to the discard pile.
## Generated by ActionGenerator.generate_end_of_turn_unit_actions() right after the tug of war in which
## the decaying side's units deal damage: enemy units after the player's turn ends, player units
## after the enemy's turn ends.
## Values:
## - stamina_decay: int. Stamina lost per unit. Defaults to 1. Intercept to make units tire faster/slower.
## - unit_owner_filter: int (Unit.UNIT_OWNERS, or -1 for both sides). Whose units tire. Default -1.
extends BaseAction

func perform_action() -> void:
	var action_interceptor_processors: Array[ActionInterceptorProcessor] = _intercept_action([])

	for action_interceptor_processor: ActionInterceptorProcessor in action_interceptor_processors:
		var stamina_decay: int = action_interceptor_processor.get_shadowed_action_values("stamina_decay", 1)
		var unit_owner_filter: int = action_interceptor_processor.get_shadowed_action_values("unit_owner_filter", Unit.UNIT_OWNER_AUTOMATIC)

		for unit: Unit in Battlefield.get_units(unit_owner_filter):
			unit.change_stamina(-stamina_decay)
			if unit.unit_stamina <= 0:
				unit.discard_unit()

	# safety net: any unit card stuck in the field pile without a unit goes to the discard pile
	Battlefield.release_orphaned_field_cards()

func _to_string() -> String:
	return "Decay Unit Stamina Action: " + str(get_action_value("stamina_decay", 1))
